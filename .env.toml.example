# Lexa environment — canonical config for dev / bare-metal / docker.
#
# Copy to `.env.toml` and edit. Nothing loads this file automatically:
# server/entry.ts calls applyEnvFile() at boot, and scripts/dev.sh evals the
# loader's shell exports. Real environment variables always win over file
# values; sections below are presentation only and every leaf key is the
# env-var name verbatim.

[core]
# Docker Compose project name (compose tooling only, not app config).
COMPOSE_PROJECT_NAME = "lexa-dev"
# SQLite database path. Delete data/lexa.db* to start fresh.
DATABASE_PATH = "./data/lexa.db"
PORT = "3000"
# Container image tag (compose tooling only).
# LXK_IMAGE_TAG =
# Cloudflare Tunnel token (compose tooling only).
# CF_TUNNEL_TOKEN =

[auth]
# Comma-separated superadmin emails (first-boot bootstrap; the web setup
# wizard or Settings → Team manages members afterwards).
LXK_ADMIN_EMAILS = ""

[urls]
# dev | staging | prod. Written by `bun run setup` so the seed gate works.
LXK_ENV = "dev"
# User-facing base URL for invite / set-password / share links. Empty = vite
# frontend (http://localhost:5173 in dev). The API stays on :3000.
# LXK_PUBLIC_URL =
# Comma-separated extra origins for Better Auth (dev: auto-adds localhost +
# LXK_PUBLIC_URL). Add Tailscale MagicDNS + 100.x IP if you access dev via it:
# e.g. http://homestation.tail7d8af1.ts.net:5173,http://100.123.193.119:5173
# LXK_TRUSTED_ORIGINS =
# Trust cf-connecting-ip for rate limiting only from these reverse-proxy peers
# (comma-separated IPv4/IPv6 CIDRs or bare IPs). Unset/empty = loopback only.
# LXK_TRUSTED_PROXY_CIDRS =

[github]
# GitHub sync (bootstrap only — after first boot Settings → GitHub Sync is the
# source of truth).
# GITHUB_APP_ID =
# Inline PEM private key (escaped newlines) or a path — set exactly one;
# GITHUB_PRIVATE_KEY_FILE is recommended for bare-metal/docker.
# GITHUB_PRIVATE_KEY =
# GITHUB_PRIVATE_KEY_FILE =
# GITHUB_WEBHOOK_SECRET =

[storage]
# fs | s3 | r2
# LXK_STORAGE_DRIVER =
# LXK_STORAGE_FS_ROOT =
# LXK_S3_BUCKET =
# LXK_S3_ACCESS_KEY_ID =
# LXK_S3_SECRET_ACCESS_KEY =
# LXK_S3_ENDPOINT =
# LXK_S3_REGION =

[limits]
LXK_MAX_BODY_MB = "16"
# LXK_MAX_UPLOAD_MB =
# LXK_RATE_LIMIT_MAX = "6000"
# LXK_RATE_LIMIT_WINDOW_MS = "600000"

[assistant]
# LXK_ASSISTANT_REPO_CAP =
# Jev (Typesafe System 1 advisory layer).
# TYPESAFE_API_KEY =
# TYPESAFE_BASE_URL =
# TYPESAFE_DEFAULT_MODEL =

[mcp]
# MCP managed-secret encryption (required to store MCP Bearer tokens via the
# webapp). Generate: openssl rand -base64 32. Never commit a real value; keep
# it out of DB backups.
# LXK_MCP_MASTER_KEY =
# Rotation only: set to the previous key while re-entering tokens.
# LXK_MCP_MASTER_KEY_PREV =

[logging]
LOG_LEVEL = "info"
# TANSTACK_AI_DEBUG = "1"     # 1 or {"agentLoop":true,"tools":true}
# TANSTACK_AI_JSON = "1"      # json lines, service:"tanstack-ai"

[backups]
# LXK_BACKUP_ENABLED =
# LXK_BACKUP_RETENTION =

[dev]
# Boot-time sample data: 1 = seed on empty DB, 0 = stay empty.
# Written by `bun run setup` (Y → 1, N → 0); dev.sh defaults to 1 when unset.
# LXK_SEED_DEV = "1"

[workers]
# Workers-only secret binding (Cloudflare Workers flavor). Never read on the
# Bun host.
# CRON_SECRET =
