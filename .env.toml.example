# Lexa environment — canonical local config. `bun run setup` writes `.env.toml`;
# the Workers local dev flow derives `.dev.vars` from it (`scripts/dev-workers.sh`).
# The deployed Workers runtime does not read this file: it takes vars from
# wrangler.jsonc and secrets from the Cloudflare secret store (see [workers]
# below).
#
# Copy to `.env.toml` and edit. Real environment variables always win over file
# values; sections below are presentation only and every leaf key is the env-var
# name verbatim.

[core]
# SQLite database path. Delete data/lexa.db* to start fresh.
DATABASE_PATH = "./data/lexa.db"
PORT = "3000"

[auth]
# Comma-separated superadmin emails (first-boot bootstrap; the web setup
# wizard or Settings → Team manages members afterwards).
LXK_ADMIN_EMAILS = ""

[urls]
# dev | staging | prod. Written by `bun run setup` so the seed gate works.
LXK_ENV = "dev"
# User-facing base URL for invite / set-password / share links. Empty = the
# local vite dev origin (http://localhost:5173 in dev).
# LXK_PUBLIC_URL =
# Comma-separated extra origins for Better Auth (dev: auto-adds localhost +
# LXK_PUBLIC_URL). Add Tailscale MagicDNS + 100.x IP if you access dev via it:
# LXK_TRUSTED_ORIGINS =
# Trust cf-connecting-ip for rate limiting only from these reverse-proxy peers
# (comma-separated IPv4/IPv6 CIDRs or bare IPs). Unset/empty = loopback only.
# LXK_TRUSTED_PROXY_CIDRS =

[storage]
# fs | s3 | r2
# LXK_STORAGE_DRIVER =
# LXK_STORAGE_FS_ROOT =
# LXK_S3_BUCKET =
# LXK_S3_ACCESS_KEY_ID =
# LXK_S3_SECRET_ACCESS_KEY =
# LXK_S3_ENDPOINT =
# LXK_S3_REGION =

[limits]
LXK_MAX_BODY_MB = "16"
# LXK_MAX_UPLOAD_MB =
# LXK_RATE_LIMIT_MAX = "6000"
# LXK_RATE_LIMIT_WINDOW_MS = "600000"

[features]
# Bulk task actions (Tasks page multi-select). Set to "1" to disable:
# GET /api/capabilities reports tasksBulk=false and POST
# /api/projects/:slug/tasks/bulk is refused (403 TASKS_BULK_DISABLED).
# LXK_DISABLE_TASKS_BULK =

[assistant]
# LXK_ASSISTANT_REPO_CAP =
# Chat attachments (images + docs) kill switch: set to "1" to disable the
# feature — GET /api/capabilities reports chatAttachments=false and uploads /
# sends-with-attachments are refused.
# LXK_DISABLE_CHAT_ATTACHMENTS =
# Jev (Typesafe System 1 advisory layer) is configured in the webapp
# (Admin → Assistant → Providers & Models), not here.

[secrets]
# Managed-secret encryption (required to store MCP Bearer tokens, provider API
# keys, or the Jev API key via the webapp). Generate: openssl rand -base64 32.
# Never commit a real value; keep it out of DB backups.
# LXK_SECRETS_MASTER_KEY =
# Rotation only: set to the previous key while re-entering tokens.
# LXK_SECRETS_MASTER_KEY_PREV =

[logging]
LOG_LEVEL = "info"
# TANSTACK_AI_DEBUG = "1"     # 1 or {"agentLoop":true,"tools":true}
# TANSTACK_AI_JSON = "1"      # json lines, service:"tanstack-ai"

[backups]
# LXK_BACKUP_ENABLED =
# LXK_BACKUP_RETENTION =

[dev]
# Boot-time sample data: 1 = seed on empty DB, 0 = stay empty.
# Written by `bun run setup` (Y → 1, N → 0); unset stays empty.
# LXK_SEED_DEV = "1"

[workers]
# Cloudflare Workers only. Read solely by the Workers entry (getEnvFromWorkers).
# Provision it as a Worker secret (`wrangler secret put` / dashboard), not via
# `.env.toml`.
# CRON_SECRET =
