// Staging Workers deploy template — clone-and-deploy path, no install.sh.
//
// One-time resource setup (isolated from prod):
//   bun x wrangler d1 create lexa-staging
//   bun x wrangler r2 bucket create lexa-staging-blobs
//   bun x wrangler kv namespace create lexa-staging
//
// Deploy:
//   cp wrangler.staging.example.jsonc wrangler.staging.local.jsonc
//   # fill in <ACCOUNT_ID>, <D1_DATABASE_ID>, <KV_NAMESPACE_ID>, <PUBLIC_URL>
//   bun install
//   bun run build:workers
//   bun x wrangler d1 migrations apply DB --remote --config wrangler.staging.local.jsonc
//   bun x wrangler deploy --config wrangler.staging.local.jsonc
//   bun x wrangler secret put LXK_SECRETS_MASTER_KEY --config wrangler.staging.local.jsonc
//
// Shortcut: `bun run deploy:staging` (keep data) and
// `bun run deploy:staging:reset` (wipe + recreate + update the ids below) wrap
// these steps — scripts/deploy-staging.sh.
//
// Rules:
// - Never commit the filled copy; never deploy with the root wrangler.jsonc
//   (it targets the prod worker and prod resources).
// - `wrangler … create` auto-appends the resource to the wrangler config in the
//   current directory; if that is the root wrangler.jsonc, remove the appended
//   blocks before building (a duplicate binding name fails the build).
// - This path uses wrangler's `_cf` migration journal. Do not point it at a
//   database that scripts/workers-install.ts migrated (`_migrations` journal).
// - `bun run db:migrations:apply` / `bun run deploy:workers` ignore this file
//   and hit the root config — don't use them for staging.
// - Superadmin is created by the web /setup wizard after first deploy.
// - `LXK_PUBLIC_URL` is required for browser sign-in. Set it to the deployed
//   URL (workers.dev or a custom domain). Unset, it falls back to
//   `http://localhost:5173` for the Better Auth baseURL + trustedOrigins, and
//   Better Auth rejects the real origin with `Invalid origin`.
{
  "name": "lexa-staging",
  "account_id": "<ACCOUNT_ID>",
  "main": "./dist/server/index.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js", "**/*.mjs"]
    }
  ],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },
  "vars": {
    "LXK_ENV": "production",
    "LXK_PUBLIC_URL": "<PUBLIC_URL>"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lexa-staging",
      "database_id": "<D1_DATABASE_ID>",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BLOB",
      "bucket_name": "lexa-staging-blobs"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "<KV_NAMESPACE_ID>"
    }
  ],
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issues": {
      "enabled": true
    }
  }
}
