CF_TUNNEL_TOKEN=your_cloudflare_tunnel_token
# GitHub App (two-way issue sync). PEM with escaped newlines.
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_PRIVATE_KEY_FILE=
GITHUB_WEBHOOK_SECRET=
LOG_LEVEL=info
# Cloudflare Access JWT verification. REQUIRED in front of a tunnel: set to
# your Access audience tag (https://<team>.cloudflareaccess.com/cdn-cgi/access/get-ksi)
# to require valid Access JWTs on /api and /mcp.
LXK_ACCESS_AUD=
LXK_ADMIN_EMAILS=
LXK_API_KEY=lxk_replace_me
LXK_MAX_BODY_MB=16
VITE_LXK_API_KEY=lxk_replace_me
