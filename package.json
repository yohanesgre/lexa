{
  "name": "lexa",
  "version": "2026.2.9",
  "description": "Self-hosted project management \u2014 Kanban with swimlanes/WIP limits, nested wiki, Hearth AI writing assistant.",
  "scripts": {
    "test": "vitest run",
    "test:critical": "vitest run shared server/services server/db server/repos",
    "test:full": "vitest run",
    "test:shared": "vitest run shared",
    "test:be": "vitest run shared server",
    "test:fe": "vitest run shared app",
    "test:cli": "vitest run cli/src",
    "test:hearth": "vitest run hearth",
    "prepare": "./scripts/prepare-effect.sh",
    "dev": "vite dev",
    "dev:server": "bun --env-file=.env run server/entry.ts",
    "dev:full": "bash scripts/dev.sh",
    "lexa-cli-dev": "bun run cli/src/index.ts",
    "compile:cli": "bun run scripts/compile-cli.ts",
    "install:cli-dev": "bash scripts/install-cli-dev.sh",
    "uninstall:cli-dev": "rm -f \"$HOME/.local/bin/lexa-cli-dev\"",
    "setup": "bun run scripts/setup-cli.ts",
    "build": "vite build",
    "build:workers": "LEXA_FLAVOR=workers vite build",
    "db:migrations:apply": "wrangler d1 migrations apply DB --remote",
    "deploy:workers": "bun run db:migrations:apply && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "doctor": "npx react-doctor@latest",
    "check:mobile": "bun --env-file=.env scripts/check-mobile.mjs",
    "check:invariants": "bun run scripts/check-invariants.ts",
    "ci:local": "bash scripts/ci-local.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yohanesgre/lexa.git"
  },
  "keywords": [],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/yohanesgre/lexa/issues"
  },
  "homepage": "https://github.com/yohanesgre/lexa#readme",
  "type": "module",
  "private": "true",
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@effect/platform": "^0.97.1",
    "@phosphor-icons/web": "^2.1.2",
    "@tanstack/ai": "0.53.0",
    "@tanstack/ai-anthropic": "0.18.5",
    "@tanstack/ai-openai": "0.22.5",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "1.170.18",
    "@tanstack/react-start": "1.168.32",
    "@tanstack/react-start-server": "1.167.22",
    "@tiptap/extension-code": "3.31.3",
    "@tiptap/extension-highlight": "^3.31.3",
    "@tiptap/extension-image": "3.31.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/extension-mention": "3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/extension-table": "3.31.3",
    "@tiptap/extension-table-cell": "3.31.3",
    "@tiptap/extension-table-header": "3.31.3",
    "@tiptap/extension-table-row": "3.31.3",
    "@tiptap/extension-task-item": "^3.31.3",
    "@tiptap/extension-task-list": "^3.31.3",
    "@tiptap/extension-underline": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@tiptap/suggestion": "3.31.3",
    "better-auth": "1.6.27",
    "clsx": "^2.1.1",
    "effect": "^3.22.1",
    "fractional-indexing": "^4.0.0",
    "highlight.js": "^11.12.0",
    "js-tiktoken": "^1.0.21",
    "lucide-react": "^1.41.0",
    "marked": "^18.0.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "unpdf": "1.8.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.4",
    "@cloudflare/workers-types": "^5.20260906.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/better-sqlite3": "^9.6.0",
    "@types/bun": "^1.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "6.0.4",
    "@vitest/coverage-v8": "^5.0.0",
    "better-sqlite3": "^13.0.3",
    "jsdom": "^30.0.1",
    "miniflare": "^5.20260903.0-alpha",
    "playwright": "^1.63.0",
    "react-doctor": "^0.9.13",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "8.1.5",
    "vite-plugin-inspect": "^12.0.2",
    "vitest": "^5.0.0",
    "wrangler": "^4.129.0"
  }
}
