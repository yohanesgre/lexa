{
  "name": "lexa",
  "version": "0.1.0",
  "description": "Self-hosted project management — Kanban with swimlanes/WIP limits, nested wiki, MCP server for AI agents, Forge AI writing assistant.",
  "scripts": {
    "test": "vitest run",
    "prepare": "./scripts/prepare-effect.sh",
    "dev": "vite dev",
    "dev:server": "bun --env-file=.env run server/entry.ts",
    "dev:full": "bash scripts/dev.sh",
    "lexa-cli-dev": "bun run cli/index.ts",
    "compile:cli": "bun run scripts/compile-cli.ts",
    "install:cli-dev": "bash scripts/install-cli-dev.sh",
    "uninstall:cli-dev": "rm -f \"$HOME/.local/bin/lexa-cli-dev\"",
    "setup": "bun run scripts/setup-cli.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "doctor": "npx react-doctor@latest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yohanesgre/lexa.git"
  },
  "keywords": [],
  "author": "Yohanes Grethaputra",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/yohanesgre/lexa/issues"
  },
  "homepage": "https://github.com/yohanesgre/lexa#readme",
  "type": "module",
  "private": "true",
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@effect/platform": "^0.97.0",
    "@phosphor-icons/web": "^2.1.2",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-start": "^1.168.32",
    "@tiptap/extension-highlight": "^3.29.1",
    "@tiptap/extension-link": "^3.29.1",
    "@tiptap/extension-placeholder": "^3.29.1",
    "@tiptap/extension-task-item": "^3.29.1",
    "@tiptap/extension-task-list": "^3.29.1",
    "@tiptap/extension-underline": "^3.29.1",
    "@tiptap/pm": "^3.29.1",
    "@tiptap/react": "^3.29.1",
    "@tiptap/starter-kit": "^3.29.1",
    "clsx": "^2.1.1",
    "effect": "^3.22.0",
    "fractional-indexing": "^4.0.0",
    "lucide-react": "^1.27.0",
    "marked": "^18.0.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "better-sqlite3": "^13.0.3",
    "jsdom": "^30.0.1",
    "react-doctor": "^0.9.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
