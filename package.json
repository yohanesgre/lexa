{
  "name": "lexa",
  "version": "0.3.0",
  "description": "Self-hosted project management — Kanban with swimlanes/WIP limits, nested wiki, Hearth AI writing assistant.",
  "scripts": {
    "test": "vitest run",
    "test:critical": "vitest run shared server/services server/db server/repos",
    "test:full": "vitest run",
    "prepare": "./scripts/prepare-effect.sh",
    "dev": "vite dev",
    "dev:server": "bun --env-file=.env run server/entry.ts",
    "dev:full": "bash scripts/dev.sh",
    "lexa-cli-dev": "bun run cli/src/index.ts",
    "compile:cli": "bun run scripts/compile-cli.ts",
    "install:cli-dev": "bash scripts/install-cli-dev.sh",
    "uninstall:cli-dev": "rm -f \"$HOME/.local/bin/lexa-cli-dev\"",
    "setup": "bun run scripts/setup-cli.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "doctor": "npx react-doctor@latest",
    "check:mobile": "bun --env-file=.env scripts/check-mobile.mjs",
    "check:invariants": "bun run scripts/check-invariants.ts",
    "ci:local": "bash scripts/ci-local.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yohanesgre/lexa.git"
  },
  "keywords": [],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/yohanesgre/lexa/issues"
  },
  "homepage": "https://github.com/yohanesgre/lexa#readme",
  "type": "module",
  "private": "true",
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@effect/platform": "^0.97.1",
    "@phosphor-icons/web": "^2.1.2",
    "@tanstack/ai": "0.52.0",
    "@tanstack/ai-anthropic": "0.18.3",
    "@tanstack/ai-openai": "0.22.3",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-start": "^1.168.49",
    "@tiptap/extension-highlight": "^3.30.5",
    "@tiptap/extension-image": "3.30.5",
    "@tiptap/extension-link": "^3.30.5",
    "@tiptap/extension-mention": "3.30.5",
    "@tiptap/extension-placeholder": "^3.30.5",
    "@tiptap/extension-table": "3.30.5",
