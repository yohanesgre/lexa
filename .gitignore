docs/private/
docs/superpowers/
worker-configuration.d.ts
*.log
.playwright-mcp/
dashboard-test.png
wireframes/dist/

# GitHub App private keys (PEM) — never commit
*.private-key.pem
github-app*.pem

# Command Code local state (taste learning, design reports, permissions) — never commit
.commandcode/
# Agent skills: project skills vendored under .agents/skills/
skills-lock.json
# Vendored Effect source for the effect-ts skill (version-pinned by scripts/prepare-effect.sh)
.repos/

# Deepwork session state (git-local, OpenCode-readable)
.slim/deepwork/

# lexa-swarm lane status files (heartbeats, PLAN.md) — ephemeral orchestration state
status/

# Installer scratch dirs (self-describing CWD targets) — never commit
/cf-workers/
/.deployed-url
# Deploy/verify scratch: local SQLite copies (with -wal/-shm sidecars) and
# generated compose files from release verification runs — never commit
/.staging-data/
/lexa-deploy/
# Staging Workers deploy config — filled copy of wrangler.staging.example.jsonc
/wrangler.staging.local.jsonc

# Slim worktrees — local orchestration checkouts, never commit
.slim/worktrees/
.worktrees/

# Review artifacts (HTML reports from review lanes) — never commit
.reviews/
# Antislop audit reports (per-audit markdown artifacts) — never commit
anti-slop/
# Lane reports + scratch logs (plan status lives in status/, already ignored) — never commit
.tmp/

# brainstorm-studio + local plan working artifacts (mockups, specs) — never publish
/.agents/brainstorm-studio/
/.agents/plans/

# Impeccable design-language skill (vendored under .agents/skills/impeccable/).
# The engine binary is platform-specific (20 MB) and is re-downloaded by the launcher on
# first run, so it is never committed — this keeps the repo portable and small.
.agents/skills/impeccable/scripts/bin/

# impeccable-ignore-start
# Ephemeral output, runtime state, and per-dev overrides.
# The **/ prefix covers .impeccable at the repo root or in a nested workspace.
# Shared artifacts stay tracked: config.json, live/config.json,
# design.json, surfaces/*.md, critique/*.md.
**/.impeccable/config.local.json
**/.impeccable/hook.cache.json
**/.impeccable/hook.pending.json
**/.impeccable/*.png
**/.impeccable/review/
**/.impeccable/questions/
**/.impeccable/live/server.json
**/.impeccable/live/sessions/
**/.impeccable/live/previews/
**/.impeccable/live/annotations/
**/.impeccable/live/cache/
**/.impeccable/live/manual-edit-apply-transaction.json
**/.impeccable/live/manual-edit-events.jsonl
**/.impeccable/live/manual-edit-evidence/
**/.impeccable/live/pending-manual-edits.json
**/.impeccable/live/deferred-svelte-component-accepts.json
**/.impeccable/live/*.png
# impeccable-ignore-end

