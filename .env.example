# ── core ──
COMPOSE_PROJECT_NAME=lexa-dev
DATABASE_PATH=./data/lexa.db
PORT=3000

# ── auth ──
LXK_API_KEY=lxk_replace_me
VITE_LXK_API_KEY=lxk_replace_me
LXK_ADMIN_EMAILS=
LXK_HEARTH_DAEMON_TOKEN=
LXK_ACCESS_AUD=
LXK_ACCESS_TEAM=

# ── server urls ──
LXK_ENV=
LXK_PUBLIC_URL=
# Comma-separated extra origins for Better Auth (dev: auto-adds localhost + LXK_PUBLIC_URL).
# Add Tailscale MagicDNS + 100.x IP if you access dev via Tailscale:
# e.g. http://homestation.tail7d8af1.ts.net:5173,http://100.123.193.119:5173,https://homestation.tail7d8af1.ts.net
LXK_TRUSTED_ORIGINS=

# ── github sync (bootstrap only — after first boot Settings → GitHub Sync is source of truth) ──
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_PRIVATE_KEY_FILE=
GITHUB_WEBHOOK_SECRET=

# ── storage ──
# LXK_STORAGE_DRIVER=fs  # fs | s3 | r2
# LXK_STORAGE_FS_ROOT=
# LXK_S3_BUCKET=
# LXK_S3_ACCESS_KEY_ID=
# LXK_S3_SECRET_ACCESS_KEY=
# LXK_S3_ENDPOINT=
# LXK_S3_REGION=

# ── limits ──
LXK_MAX_BODY_MB=16
# LXK_MAX_UPLOAD_MB=
# LXK_RATE_LIMIT_MAX=6000
# LXK_RATE_LIMIT_WINDOW_MS=600000
# LXK_HEARTH_REPO_CAP=
# HEARTH_STALE_RUN_MIN=

# ── logging / debug ──
LOG_LEVEL=info
# TANSTACK_AI_DEBUG=1            # 1 or {"agentLoop":true,"tools":true}
# TANSTACK_AI_JSON=1             # json lines service:"tanstack-ai"

# ── dev / backups ──
# LXK_SEED_DEV=1
# LXK_BACKUP_ENABLED=
# LXK_BACKUP_RETENTION=
