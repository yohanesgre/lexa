COMPOSE_PROJECT_NAME=lexa-dev
DATABASE_PATH=./data/lexa.db
# GitHub App (two-way issue sync). BOOTSTRAP ONLY: imported into the Settings
# DB once at boot when the DB keys are empty — after that, Settings → GitHub
# Sync (admin) is the source of truth, applied live, and env is ignored until
# a key is cleared (re-imported at next boot). Private key either inline
# (escaped \n):
#   GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# or as a file path (read at mirror time, no escaping — recommended for local dev):
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_PRIVATE_KEY_FILE=
GITHUB_WEBHOOK_SECRET=
LOG_LEVEL=info
# Cloudflare Access JWT verification (opt-in). Set to your Access audience
# tag (https://<team>.cloudflareaccess.com/cdn-cgi/access/get-ksi) to require
# valid Access JWTs on /api — otherwise only API keys are checked.
LXK_ACCESS_AUD=
# Cloudflare Access team subdomain (e.g. "myteam" for myteam.cloudflareaccess.com).
# When set, the server injects a logout meta so the UI can offer "Sign out"
# (redirects to Access logout). Without it, Sign out is hidden.
LXK_ACCESS_TEAM=
LXK_ADMIN_EMAILS=
LXK_API_KEY=lxk_replace_me
# Forge daemon shared secret (Settings → API Keys alternative for daemons)
LXK_FORGE_DAEMON_TOKEN=
# Max request body size for /api in MB (default 16). Webhook payloads
# are hard-capped at 1MB before HMAC verification, regardless of this value.
LXK_MAX_BODY_MB=16
# Public base URL of this server (default http://localhost:3000). Used for
# Better Auth baseURL/trustedOrigins and for invite/set-password/share links.
# Set it to the host you access the server from, e.g. LAN or Tailscale:
#   LXK_PUBLIC_URL=http://192.168.0.131:3000
LXK_PUBLIC_URL=
# Extra origins (comma-separated) allowed on cookie-bearing auth POSTs —
# use when accessing the server from other hosts than LXK_PUBLIC_URL
# (e.g. vite dev on the LAN IP, a Tailscale MagicDNS name):
#   LXK_TRUSTED_ORIGINS=http://192.168.0.131:5173,http://machine.tailnet.ts.net:3000
LXK_TRUSTED_ORIGINS=
# Per-IP rate limit over the /api window (defaults: 6000 req /
# 10 min). BOOTSTRAP ONLY: imported into the Settings DB once at boot when the
# DB keys are empty — after that the Settings UI is the source of truth and
# env is ignored. Forge machine surfaces (daemon logs, runtime registration,
# the 3s listener heartbeat) are exempt — they are key/token-gated by design.
# LXK_RATE_LIMIT_MAX=6000
# LXK_RATE_LIMIT_WINDOW_MS=600000
# Boot-time sample data (dev only): set by scripts/dev.sh; don't enable in prod.
# LXK_SEED_DEV=1
PORT=3000
VITE_LXK_API_KEY=lxk_replace_me
