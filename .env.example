COMPOSE_PROJECT_NAME=lexa-dev
DATABASE_PATH=./data/lexa.db
# GitHub App (two-way issue sync). Private key either inline (escaped \n):
#   GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# or as a file path (read at boot, no escaping — recommended for local dev):
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_PRIVATE_KEY_FILE=
GITHUB_WEBHOOK_SECRET=
LOG_LEVEL=info
# Cloudflare Access JWT verification (opt-in). Set to your Access audience
# tag (https://<team>.cloudflareaccess.com/cdn-cgi/access/get-ksi) to require
# valid Access JWTs on /api and /mcp — otherwise only API keys are checked.
LXK_ACCESS_AUD=
# Cloudflare Access team subdomain (e.g. "myteam" for myteam.cloudflareaccess.com).
# When set, the server injects a logout meta so the UI can offer "Sign out"
# (redirects to Access logout). Without it, Sign out is hidden.
LXK_ACCESS_TEAM=
LXK_ADMIN_EMAILS=
LXK_API_KEY=lxk_replace_me
# Forge daemon shared secret (Settings → API Keys alternative for daemons)
LXK_FORGE_DAEMON_TOKEN=
# Max request body size for /api and /mcp in MB (default 16). Webhook payloads
# are hard-capped at 1MB before HMAC verification, regardless of this value.
LXK_MAX_BODY_MB=16
# Boot-time sample data (dev only): set by scripts/dev.sh; don't enable in prod.
# LXK_SEED_DEV=1
PORT=3000
VITE_LXK_API_KEY=lxk_replace_me
