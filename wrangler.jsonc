// Cloudflare Workers configuration (see docs/DEPLOYMENT.md). The `main` field
// points at the Workers entry the Vite build emits; bindings (D1, R2, KV) are
// declared here and the install-script provisioner binds real ids into a
// per-deploy config. See ADR-0002 and docs/CLOUDFLARE_WORKERS.md (design
// authority for the Workers deploy target).
{
	"name": "lexa",
	"main": "server/workers-entry.ts",
	"compatibility_date": "2026-08-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	// Raw from-source bundling. `main` points at source
	// (server/workers-entry.ts), so a `wrangler deploy` that resolves this
	// root `main` with no Vite build output bundles from source and needs
	// these resolves: dropping the block fails that dry-run with
	// `Could not resolve "bun:sqlite"` (server/auth.ts:8). `bun:sqlite` is a
	// Bun builtin no other runtime can resolve (vitest maps it to a
	// node:sqlite shim the same way); the worker never constructs it — see
	// server/workers-shims/bun-sqlite.ts. `@tanstack/react-start/server`
	// pulls Vite-virtual modules unresolvable outside the vite build (see
	// server/workers-shims/start-server.ts); `better-auth/tanstack-start`
	// likewise. `node:fs` has no filesystem on Workers (see
	// server/workers-shims/node-fs.ts) — the R2/D1 drivers serve those roles,
	// so the stubs never execute on this flavor.
	//
	// Under `vite build` the `@cloudflare/vite-plugin` reads this block ONLY
	// to emit its not-applicable warning (hence the dev-boot "alias ...
	// ignored ... using Vite" warning; the plugin tracks it in
	// `nonApplicableWorkerConfigs.notRelevant` and then drops it); the vite
	// build links its own `resolve.alias` from vite.config.ts. After
	// `build:workers`, a bare `wrangler deploy` honours the build's
	// `.wrangler/deploy/config.json` redirect to `dist/server/wrangler.json`
	// (`main: index.js`, `no_bundle: true`) and reads neither this block nor
	// `server/workers-entry.ts` — so the `deploy:workers` step (which runs
	// after `build:workers`) does not bundle from source either. Grep-
	// confirmed: the built-bundle deploys — staging
	// (wrangler.staging.example.jsonc, dist + no_bundle), install
	// (scripts/lib/cf-deploy.ts), `lexa-cli deploy --runtime workers`
	// (cli/src/worker.ts) — likewise rebuild the config from
	// dist/server/wrangler.json and never read this alias. Kept because a
	// buildless from-source `wrangler deploy` still resolves this root `main`
	// and needs the resolves.
	"alias": {
		"bun:sqlite": "./server/workers-shims/bun-sqlite.ts",
		"better-auth/tanstack-start": "./server/workers-shims/better-auth-tanstack-start.ts",
		"@tanstack/react-start/server": "./server/workers-shims/start-server.ts",
		"node:fs": "./server/workers-shims/node-fs.ts"
	},
	"vars": {
		"LXK_ENV": "production"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "lexa",
			// Placeholder id — Deploy Button / Builds provision the real database
			// and overwrite this. The install-script provisioner binds the real id
			// into a per-deploy wrangler config (see install.sh / docs/
			// CLOUDFLARE_WORKERS.md). Binding name DB is frozen (deploy scripts
			// must reference the binding, never the database name).
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "BLOB",
			"bucket_name": "lexa-blobs"
		}
	],
	"kv_namespaces": [
		{
			"binding": "KV",
			// Placeholder; `lexa-cli deploy workers` overwrites with the real id.
			"id": "00000000000000000000000000000000"
		}
	],
	// Durable Object migration history (frozen). v1 records the original
	// `LexaAssistantAgent` DO class; v2 deletes it now that the assistant DO
	// stack is retired (ADR-0005). Both tags must stay: an existing prod
	// deployment still owns the DO, and Cloudflare refuses a version that drops
	// the class without this delete-class migration (CF error 10064). A fresh
	// install never carries this history — the installer/CLI emit no DO
	// migrations.
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"LexaAssistantAgent"
			]
		},
		{
			"tag": "v2",
			"deleted_classes": [
				"LexaAssistantAgent"
			]
		}
	],
	// Scheduled tick: `webhook_events` (7-day) + `device_login_requests` prune
	// and R2 backup retention — the ONLY pruner of either on Workers. The
	// assistant schedule drain that once rode this cron is gone (ADR-0005 D2);
	// the tick only prunes/retains. Kept in the config so both the wrangler and
	// installer deploy paths attach it; a dashboard-only upload must add it
	// manually (docs/DEPLOYMENT_DASHBOARD.md).
	"triggers": {
		"crons": [
			"*/15 * * * *"
		]
	},
	// Cloudflare observability defaults, spelled out explicitly.
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"redact_query_string": true,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true,
			"persist": true
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true
		},
		"issues": {
			"enabled": true
		}
	}
}