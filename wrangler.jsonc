{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "lexa",
	"main": "@tanstack/react-start/server-entry",
	"compatibility_date": "2026-01-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"workers_dev": false,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "lexa-db",
      "database_id": "250ae759-1805-4edf-895f-b85e716d345f",
			"migrations_dir": "migrations"
		},
		{
			"binding": "lexa_db",
			"database_name": "lexa-db",
			"database_id": "250ae759-1805-4edf-895f-b85e716d345f"
		}
	],
	"triggers": {
		"crons": [
			"17 3 * * *"
		]
	},
	"observability": {
		"enabled": true
	}
}